<!-- Mobile Create & Cancel posting Script -->
<script>
    $("#create-post").click(function (e) {
        e.preventDefault();
        $(".posting").toggleClass("active");
        $(".mb").toggleClass("deactive");
    });

    $("#cancel-post").click(function (e) {
        e.preventDefault();
        $(".posting").toggleClass("active");
        $(".mb").toggleClass("deactive");
    });
</script>
