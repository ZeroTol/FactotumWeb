<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Factotum.live</title>

    <environment include="Development">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link href="https://fonts.googleapis.com/css?family=Nunito+Sans" rel="stylesheet">
        <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />

        <script src="~/lib/jquery/dist/jquery.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
              asp-fallback-href="~/lib/bootstrap/dist/css/bootstrap.min.css"
              asp-fallback-test-class="sr-only" asp-fallback-test-property="position" asp-fallback-test-value="absolute" />
        <link href="https://fonts.googleapis.com/css?family=Nunito+Sans" rel="stylesheet">
        <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />

        <script src="https://ajax.aspnetcdn.com/ajax/jquery/jquery-3.3.1.min.js"
                asp-fallback-src="~/lib/jquery/dist/jquery.min.js"
                asp-fallback-test="window.jQuery"
                crossorigin="anonymous"></script>
        <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"
                asp-fallback-src="~/lib/bootstrap/dist/js/bootstrap.min.js"
                asp-fallback-test="window.jQuery && window.jQuery.fn && window.jQuery.fn.modal"
                crossorigin="anonymous"></script>
    </environment>
</head>

<body id="page-top">
    <!-- COOOKIES TOASTER -->
    <div class="toast fade hide" style="min-width: 100%;" role="alert" aria-live="assertive" aria-atomic="true" data-autohide="false">
        <div class="toast-body">
            <div class="row p-lg-0 p-3">
                <div class="col-lg-11 pl-2 pb-1 vertical-center">
                    By continuing using this service, you aree that we are storing some minor information in you browser cookies, that helps you to see your highlighted posts and makes whole service faster for you convinient use. Closing this dialog, you agree with our policy and ability to store cookies on your device.
                    <br>
                    <a href="Privacy & Policy">Privacy & Policy</a>
                </div>
                <div class="col-lg-1 text-right pb-1">
                    <button id="factotumPrivacyAndPolicy" cname=".ftPaP" cvalue="123" type="button" class="ml-2 mb-1 close nofocus pt-1" data-dismiss="toast" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Menu -->
    <div class="modal right fade" id="menu_" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content disable-border-radius">
                <div class="menu-header">
                    <button type="button" class="close nofocus" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="d-block d-md-none"><img src="~/img/logo.svg" alt="Home" class="logo_sm"></div>
                <div class="modal-body">
                    <div class="list-group">
                        <button type="button" class="list-group-item list-group-item-action nofocus active" data-toggle="modal" data-target="#popup_posting_1">  Home</button>
                        <button type="button" class="list-group-item list-group-item-action nofocus" onclick="@("window.location.href='" + @Url.Action("Index", "Philosophy") + "'");"> Philosophy</button>
                        <button type="button" class="list-group-item list-group-item-action nofocus" onclick="@("window.location.href='" + @Url.Action("Index", "DevBlog") + "'");">    Dev Blog</button>
                        <button type="button" class="list-group-item list-group-item-action nofocus" onclick="@("window.location.href='" + @Url.Action("Index", "Policy") + "'");">     Policy</button>
                        <button type="button" class="list-group-item list-group-item-action nofocus" onclick="@("window.location.href='" + @Url.Action("Index", "Member") + "'");">     Member</button>
                        <button type="button" class="list-group-item list-group-item-action nofocus" data-toggle="modal" data-target="#popup_password_recovery">                        Password Recovery</button>
                        <button type="button" class="list-group-item list-group-item-action nofocus" data-toggle="modal" data-target="#popup_register">                                 Create an account</button>
                    </div>
                    <div class="list-group pt-5">
                        <button type="button" class="list-group-item list-group-item-action nofocus" data-toggle="modal" data-target="#popup_login">Log in</button>
                    </div>
                    <div class="list-group pt-5">
                        <button type="button" class="list-group-item list-group-item-action nofocus btn-sm">         Privacy & Policy</button>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- Menu -->
    <!-- LOGIN -->
    <div class="modal fade" id="popup_login" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    Log in
                    <button type="button" class="close nofocus" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="pt-3" id="">
                        <div class="alert alert-primary" role="alert">
                            Continue with Facebook
                        </div>
                        <div class="alert alert-info" role="alert">
                            Continue with Instagram
                        </div>
                        <div class="alert alert-warning" role="alert">
                            Continue with Google
                        </div>
                        <hr class="my-4">
                        <div class="text-left pb-4"><strong>Or with old school approach?</strong></div>
                        <form>
                            <div class="form-group">
                                <label for="exampleInputEmail1" class="small">Email address</label>
                                <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="Enter email">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputPassword1" class="small">Password</label>
                                <input type="password" class="form-control" id="exampleInputPassword1" placeholder="Password">
                                <small id="emailHelp" class="form-text text-muted"><a href="passrecovery_dialog" class="link">Forgot your password?</a></small>
                            </div>
                            <div class="form-group form-check">
                                <input type="checkbox" class="form-check-input" id="exampleCheck1">
                                <label class="form-check-label small" for="exampleCheck1">Remember me</label>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="modal-footer">
                    <div class="col-12 vertical-bottom">
                        <button type="submit" class="btn btn-primary btn-block">Submit</button>
                        <div class="text-center py-4"><a href="register modal" class="link small">Don't have an account? Create one!</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- DIALOG -->
    <!-- LOGIN -->
    <div class="modal fade" id="popup_password_recovery" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    Password recovery
                    <button type="button" class="close nofocus" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="pt-3" id="">
                        <div class="collapse show" id="collapse_recovery">
                            <form>
                                <div class="form-group">
                                    <label for="exampleInputEmail1" class="small">Email address</label>
                                    <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="Enter email">
                                </div>
                            </form>
                        </div>
                        <div class="collapse text-center" id="collapse_recovery">
                            Recovery instructions were sent to your email.<br>
                            alexius.yushkov@gmail.com<br>
                            <div class="small pt-3">Please wait 10 minutes before clicking resend.</div>
                            <div class="pt-4 pb-2">
                                <a href="resend?" class="link">Resend</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="collapse show" id="collapse_recovery">
                    <div class="modal-footer">
                        <div class="col-12 vertical-bottom">
                            <button type="submit" class="btn btn-primary btn-block" data-toggle="collapse" data-target="#collapse_recovery">Submit</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- DIALOG -->
    <!-- REGISTER -->
    <div class="modal fade" id="popup_register" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    Create account
                    <button type="button" class="close nofocus" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="pt-3" id="">
                        <div class="collapse show" id="collapse_Register">
                            <form>
                                <div class="form-group">
                                    <label for="exampleInputEmail1" class="small">Email address</label>
                                    <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="Enter email">
                                </div>
                                <div class="form-group">
                                    <label for="exampleInputPassword1" class="small">Password</label>
                                    <input type="password" class="form-control" id="exampleInputPassword1" placeholder="Password">
                                </div>
                                <div class="form-group">
                                    <label for="exampleInputPassword1" class="small">Password again</label>
                                    <input type="password" class="form-control" id="exampleInputPassword1" placeholder="Password check">
                                </div>
                                <div class="form-group">
                                    <label for="exampleInputEmail1" class="small">Username</label>
                                    <input type="text" class="form-control" id="exampleInputUsername" aria-describedby="emailHelp" placeholder="Your nickname">
                                </div>
                                <div class="form-group form-check">
                                    <input type="checkbox" class="form-check-input" id="exampleCheck1">
                                    <label class="form-check-label small" for="exampleCheck1">I agree with <a href="terms & conditions" class="link">terms & conditions</a></label>
                                </div>
                            </form>
                        </div>
                        <div class="collapse text-center" id="collapse_Register">
                            Confirmation email was sent to your email.<br>
                            alexius.yushkov@gmail.com<br>
                            <div class="small pt-3">Please wait 10 minutes before clicking resend.</div>
                            <div class="pt-4 pb-2">
                                <a href="resend?" class="link">Resend</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="collapse show" id="collapse_Register">
                    <div class="modal-footer">
                        <div class="col-12 vertical-bottom">
                            <button type="submit" class="btn btn-primary btn-block" data-toggle="collapse" data-target="#collapse_Register">Register</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- DIALOG -->
    <!-- DIALOG_post -->
    <div class="modal fade" id="popup_posting_0" tabindex="-3" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    Lets check everything
                    <button type="button" class="close nofocus" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="collapse show" id="collapsePostingSteps">

                        <div class="card-body pb-5">

                            <div class="p-1 pb-2"> NASA Awards Launch Range Operations Contract for Wallops Range Operations Contr</div>
                            <div class="small">
                                <a href="https://www.nasa.gov/press-release/nasa-awards-launch-range-operations-contract-for-wallops-flight-facility/">https://www.nasa.gov/press-release/nasa-awards-launch-range-operations-contract-for-wallops-flight-facility/</a>
                            </div>
                        </div>
                        <div class="pb-2 small">Tags of associations (optional)</div>
                        <input type="text" class="form-control" id="new_post_hashtags" placeholder="#something #absolutely #random">
                        <div class="pb-2 small">
                            <br />
                            <button id="new_post_submit_button" type="button" class="btn btn-primary btn-md btn-block" data-toggle="collapse" data-target="#collapsePostingSteps">Post</button>
                        </div>
                    </div>

                    <div class="collapse" id="collapsePostingSteps">
                        <div class="card card-body">
                            <div class="small pb-2">
                                Thank you so much for new fact!
                                <br>
                                Fact will be checked and you will see this in list very soon!
                                <br>
                            </div>
                        </div>

                        @*<div class="card card-body">
                                <div class="small pb-2">
                                    A good colour is like a good mood.
                                    <br>
                                    Tweak your tags by pasting your HEX code below.
                                </div>
                                <div><a href="#" class="badge badge-primary">#yourstyle</a> <a href="#" class="badge badge-primary">#yourstyle</a></div>

                                <div class="row">
                                    <div class="col-sm-6 col-12 pt-4">
                                        <label for="exampleInputEmail1" class="small">Background colour</label>
                                        <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="#HEX" value="#0C66FF" disabled>
                                    </div>
                                    <div class="col-sm-6 col-12 pt-4">
                                        <label for="exampleInputEmail1" class="small">Text colour</label>
                                        <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="#HEX" value="#FFFFFF" disabled>
                                    </div>
                                </div>
                                <div class="pt-4 text-danger small">
                                    This functionality is available for members only.
                                </div>
                            </div>*@
                    </div>

                </div>

                <div class="modal-footer">
                    <div class="small text-muted">You cannot remove or edit your fact after posting it. No politics & no adult stricted content please!</div>
                    <div class="col-4 vertical-bottom">
                        <button type="button" class="btn btn-primary btn-md btn-block" data-toggle="collapse" data-target="#collapsePostingSteps" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">
                                Close
                            </span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- DIALOG_post -->
    <!-- DIALOG_EXISTS ------------------------------------------------------------->
    <div class="modal fade" id="popup_posting_1" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    Fact is not unique
                    <button type="button" class="close nofocus" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="pb-4">We found same proof link in our Data Base</div>
                    <div class="card card-body border-danger">
                        <div class="pb-2 small text-muted">1 Aug</div>
                        <div class="pb-2 p-1"> NASA Awards Launch Range Operations Contract for Wallops Range Operations Contr</div>
                        <div class="pb-2 small">
                            <a href="https://www.nasa.gov/press-release/nasa-awards-launch-range-operations-contract-for-wallops-flight-facility/">https://www.nasa.gov/press-release/nasa-awards-launch-range-operations-contract-for-wallops-flight-facility/</a>
                        </div>
                        <div class="text-right">+473 823</div>
                    </div>

                </div>

                <div class="modal-footer">
                    <div class="small text-muted">All highlighted facts are stored in your browser cookies, as unique id-keys. Helps to track it visually.</div>
                    <div class="col-4 vertical-bottom">
                        <button type="button" class="btn btn-danger btn-md btn-block" data-toggle="" data-target="#collapsePostingSteps">Highlight</button>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- DIALOG_EXISTS ------------------------------------------------------------->

    @RenderBody()

    <div class="loader text-center"><div class="spinner-grow text-primary" role="status"><span class="sr-only">Loading...</span></div></div>

    <footer>
        <p>&copy; 2019 - Factotum.live</p>
    </footer>


    @RenderSection("Scripts", required: false)

    <environment include="Development">
        <script src="~/js/site.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/site.js" asp-append-version="true"></script>
    </environment>
    <script type="text/javascript">
        $("#new_post_submit_button").click(function (e) {
            debugger;


            //public class MDashBoardFact
            //    {
            //        public int FactId { get; set; }
            //        public String FactTitle { get; set; }
            //        public String FactHashTags { get; set; }
            //        public String FactLink { get; set; }
            //        public DateTime? FactCreateDate { get; set; }
            //        public int FactRating { get; set; }
            //        public DateTime? FactLastRateDate { get; set; }
            //    }

            var fact = new Object();
            var fact_title = $("#new_post_title").val();

            if ((fact_title == null) || (fact_title.length <= 0)) {
                e.preventDefault();
                (alert("Please specify title!"));
                return;
            }

            var fact_link = $("#new_post_link").val();
            if ((fact_link == null) || (fact_link.length <= 0)) {
                e.preventDefault();
                (alert("Please specify link!"));
                return;
            }

            var fact_hashTags = $("#new_post_hashtags").val();
            if ((fact_hashTags != null) || (fact_hashTags.length <= 0)) {
                fact.FactHashTags = fact_hashTags;
            }


            fact.FactTitle = fact_title;
            fact.FactLink = fact_link;
            //fact.FactHashTags = "#test";
            //fact.FactCreateDate = null;
            //fact.FactRating = 0;
            //fact.FactLastRateDate = null;
            debugger;
            //var vote_id = $(this).attr("vote-id");
            //var requestUrl = "https://localhost:44347/api/FakeApi/AppendFact"
            //var requestUrl = `https://localhost:5001/api/message/AppendFact`;
            var requestUrl = `https://factotumwebapi.azurewebsites.net/api/message/AppendFact`;

            $.ajax({
                type: "POST",
                url: requestUrl,
                data: JSON.stringify(fact),
                success: function (data) {
                    debugger;
                    $(".posting").toggleClass("active");
                    $(".mb").toggleClass("deactive");
                },
                dataType: "json",
                contentType: "application/json; charset=utf-8"
            });

        });
    </script>

</body>
</html>
