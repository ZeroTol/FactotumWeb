@model List<FactotumModels.MDashBoardFact>
@using System.Globalization;
<!-- COOOKIES TOASTER -->
<div class="toast" style="min-width: 100%;" role="alert" aria-live="assertive" aria-atomic="true" data-autohide="false">
    <div class="toast-body">
        <div class="row p-lg-0 p-3">
            <div class="col-lg-11 pl-2 pb-1 vertical-center">
                By continuing using this service, you aree that we are storing some minor information in you browser cookies, that helps you to see your highlighted posts and makes whole service faster for you convinient use. Closing this dialog, you agree with our policy and ability to store cookies on your device.
                <br>
                <a href="Privacy & Policy">Privacy & Policy</a>
            </div>
            <div class="col-lg-1 text-right pb-1">
                <button id="factotumPrivacyAndPolicy" type="button" class="ml-2 mb-1 close nofocus pt-1" data-dismiss="toast" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        </div>
    </div>
</div>


<div class="overflowy">
    <!-- /#page-content-wrapper -->
    <!-- Page Content -->
    @*<button id="testbtnCreate" type="button">Test me Create!</button>*@
    @*<button id="testbtnCheck" type="button">Test me Check!</button>*@
    <div class="header">
        <div class="d-flex justify-content-between d-block d-md-none">
            <div class="pl-2 mob_head_set"></div>
            <div class="p-2 mob_head_set mb">
                <button type="button" class="btn btn-link" id="create-post"> > Create post < </button>
            </div>
            <div class="p-2 mob_head_set">
                <button type="button" class="btn btn-link" data-toggle="modal" data-target="#menu_" />
                <img src="~/img/Icon/Menu.svg">
            </div>
        </div>

        <div class="container">
            <div class="row posting">
                <div class="col-lg-8 col-md-8">
                    <textarea id="new_post_title" class="form-control form-control-md mob-form-extend" rows="1" type="text" placeholder="Type a fact that describes something just happened or being clued this week"></textarea>
                </div>
                <div class="col-md-2 col-12 pt-md-0 pt-2">
                    <input id="new_post_link" class="form-control form-control-md" type="text" placeholder="Proof Link">
                </div>
                <div class="col-6 d-block d-md-none pt-md-0 pt-2">
                    <button type="button" class="btn btn-outline-danger btn-block" id="cancel-post">Cancel</button>
                </div>
                <div class="col-md-2 col-6 pt-md-0 pt-2">
                    <button type="button" class="btn btn-primary btn-md btn-block" data-toggle="modal" data-target="#popup_posting_0">Post</button>
                </div>
            </div>
        </div>
    </div>

    <div class="navigator">
        <div class="container">
            <div class="row">
                <div class="col-md-3 d-none d-md-block">
                    <div class="text-left">
                        <a href="/">
                            <img src="~/img/logo.svg" alt="Home" class="logo">
                        </a>
                    </div>
                </div>
                <div class="col-md-6 vertical-center">
                    <div class="text-center">
                        <div class="btn-group btn-group-toggle" data-toggle="buttons">
                            <label id="by_rating_button" data-order-type="byrating" class="btn btn-outline-primary active btn-sm">
                                <input type="radio" name="options" id="option1" autocomplete="off" checked> By rating
                            </label>
                            <label id="latest_rated_button" data-order-type="latestrated" class="btn btn-outline-primary btn-sm">
                                <input type="radio" name="options" id="option2" autocomplete="off"> Latest rated
                            </label>
                            <label id="latest_added_button" data-order-type="latestadded" class="btn btn-outline-primary btn-sm">
                                <input type="radio" name="options" id="option3" autocomplete="off"> Latest added
                            </label>
                        </div>
                    </div>

                </div>
                <div class="col-sm-3 d-none d-md-block vertical-center">
                    <div class="text-right">
                        <button type="button" class="btn btn-link" data-toggle="modal" data-target="#menu_" />
                        <img src="~/img/Icon/Menu.svg">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="">
        <div class="container">
            <div class="row justify-content-center py-md-3 py-4">
                <div class="col-md-2 col-sm-12 col-12"></div>
                <div class="col-md-8 col-sm-12 col-12 text-center vertical-center">
                    <a href="#" class="badge badge-primary">#primary</a>
                    <a href="#" class="badge badge-primary">#primary</a>
                    <a href="#" class="badge badge-primary">#primary</a>
                    <a href="#" class="badge badge-primary">#primary</a>
                </div>
                <div class="col-md-2 col-sm-6 col-8 pt-md-0 pt-3 pb-md-0 pb-2 text-md-right text-center"> <input class="form-control form-control-sm search-form" type="text" placeholder="Add #filter"></div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row table-head">
            <div class="col-md-7 col">Fact</div>
            <div class="col-md-1 col-sm-1 d-none d-md-block text-right"></div>
            <div class="col-2 d-none d-md-block">Proof</div>
            <div class="col-md-2 col text-right">Rating</div>
        </div>
        <div id="content_container">
            @foreach (var fact in Model)
            {
                <div class="row table-post">
                    <div class="col-md-7 col-8  order-md-1 order-1">
                        @fact.FactTitle
                        <br />
                        @{
                            if ((fact.FactHashTags != null) && (fact.FactHashTags.Length > 0))
                            {
                                var arr = fact.FactHashTags.Split("#");

                                if (arr.Length > 0)
                                {
                                    foreach (var has_tag in arr)
                                    {
                                        if (has_tag.Length > 0)
                                        {
                                            <a href="#" class="badge badge-primary">#@has_tag</a>
                                        }
                                    }
                                }
                            }
                        }


                    </div>
                    <div class="col-md-1 col-6 order-md-2 order-4 post-time text-right">
                        @{

                            DateTime? date = DateTime.Now;
                            var monthName = fact.FactCreateDate?.Date.ToString("MMM");

                        }
                        @fact.FactCreateDate?.Date.Day.ToString() @monthName
                    </div>
                    <div class="col-md-2 col-6 order-md-3 order-3 post-link">
                        <a href="https://@fact.FactLink" target="_blank">@fact.FactLink</a>
                    </div>
                    <div class="col-md-2 col-4 order-md-4 order-2 text-right">
                        <div class="row">
                            <div class="col-lg-4 col-md-12 col-12 order-lg-1 order-md-2 order-2 text-right">

                                <div class="btn-group-toggle post_vote" data-toggle="buttons">
                                    <label class="btn btn-rate" data-vote-minus vote-id="@fact.FactId">
                                        <input type="radio" name="options" id="option1" autocomplete="off">-
                                    </label>
                                    <label class="btn btn-rate" data-vote-plus vote-id="@fact.FactId">
                                        <input type="radio" name="options" id="option2" autocomplete="off">+
                                    </label>
                                </div>
                            </div>

                            <div class="col-lg-8 col-md-12 col order-lg-2 order-md-1 order-1 text-right">
                                @{
                                    bool isBannedRating = fact.FactRating < 0;
                                    bool isGoldenRating = fact.FactRating >= 900;
                                }
                                <div class="post_rating @(isGoldenRating  ? "golden" : "") @(isBannedRating  ? "banned" : "")">
                                    <span id="data-vote-rating-@fact.FactId">
                                        @{

                                            var ratingForDisplay = String.Format("{0:### ### ### ###}", fact.FactRating);
                                            ratingForDisplay = (fact.FactRating > 0) ? "+" + ratingForDisplay : fact.FactRating.ToString();
                                        }

                                        @ratingForDisplay

                                    </span>
                                    @if (isGoldenRating)
                                    {
                                        <div class="golden-dot"></div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

