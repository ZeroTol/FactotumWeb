@model List<FactotumModels.EMessage>

@{
    ViewData["Title"] = "Factotum";
}
<div>
    <hr class="line"/>
    <div class="header">
        <table style="width:70%">
        <tr>
            <td style="width:20%"><img src="/images/logo.svg" alt="Factotum.live" class="img-responsive" /></td>
            <td style="width:63%;text-align:center;">
                <span class="Text-Value">By rating</span>
                <span class="Text-Value">Latest rated</span>
                <span class="Text-Value">Latest</span></td>
            <td style="width:15%"></td>
            <td><img src="/images/btn_menu.svg" alt="Menu" class="img-responsive" /></td>
        </tr>
        </table>
    </div>
</div>
<br />
<div style="display:flex;justify-content:center;">
    <!--Table-->
    <table id="tMessages" style="width:70%;" class="table">
        <!--Table head-->
        <thead>
            <tr>
                <th class="facthead" style="padding-left: 25px;">Fact</th>
                <th class="createhead">Created</th>
                <th class="linkhead">Proof Link</th>
                <th class="buttonhead"></th>
                <th class="lasthead" style="padding-right: 25px;">Rating</th>
            </tr>
        </thead>
        <!--Table head-->
        <!--Table body-->
        <tbody>
            @{
                foreach (var msg in Model)
                {
                    var rate = "";
                    if (msg.Rating < 0)
                    {
                        rate = "-";
                    }
                    else
                    {
                        rate = "+";
                    }

                    rate += msg.Rating.ToString();
                    var msgdate = msg.CreatedDate.ToString("MM-dd-yyyy H:mm");

                <tr>
                    <td class="facthead" style="padding-left: 25px;">@msg.Title</td>
                    <td class="createhead">@msgdate</td>
                    <td class="linkhead"><a href="@msg.Link" target="_blank">@msg.Link</a></td>
                    <td class="buttonhead">
                        <div>
                            <img src="/images/btn_minus.svg" alt="Dislike!"/>
                            <img src="/images/btn_plus.svg" alt="Like!"/>
                        </div>
                    </td>
                    <td class="lasthead" style="padding-right: 25px;">+100</td>
                </tr>

                }
            }

        </tbody>
        <!--Table body-->
    </table>
    <!--Table-->
</div>
<br /><br /><br />
