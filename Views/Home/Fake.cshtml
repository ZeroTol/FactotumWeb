<div class="overflowy" id="main_page_content_div">
    <!-- /#page-content-wrapper -->
    <!-- Page Content -->
    <div>
        <div class="header">
            <div class="d-flex justify-content-between d-block d-md-none">
                <div class="p-2 mob_head_set"></div>
                <div class="p-2 mob_head_set mb">
                    <button type="button" class="btn btn-link" id="create-post">
                        Create a post
                    </button>
                </div>
                <div class="p-2 mob_head_set">
                    <button type="button" class="btn btn-link" data-toggle="modal" data-target="#myModal2" />
                    <img src="~/images/Icon/Menu.svg">
                </div>
            </div>

            <div class="container">
                <div class="row posting">
                    <div class="col-lg-8 col-md-8">
                        <textarea id="new_post_title" class="form-control form-control-md mob-form-extend" rows="1" type="text" placeholder="Type a fact that describes something just happened or being clued this week"></textarea>
                    </div>
                    <div class="col-md-2 col-12 padding-top-0-mob-10">
                        <input id="new_post_link" class="form-control form-control-md" type="text" placeholder="Proof Link">
                    </div>
                    <div class="col-6 d-block d-md-none padding-top-0-mob-10">
                        <button type="button" class="btn btn-outline-danger btn-block" id="cancel-post">Cancel</button>
                    </div>
                    <div class="col-md-2 col-6 padding-top-0-mob-10">
                        <button id="new_post_submit_button" type="button" class="btn btn-primary btn-md btn-block">Post</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="navigator">
            <div class="container">
                <div class="row">
                    <div class="col-md-3 d-none d-md-block">
                        <div class="text-left">
                            <a href="index.html">
                                <img src="~/images/logo.svg" alt="Home" class="logo">
                            </a>
                        </div>
                    </div>
                    <div class="col-md-7 vertical-center">
                        <div class="text-center">
                            <div class="btn-group btn-group-toggle" data-toggle="buttons">
                                <label id="by_rating_button" data-order-type="byrating" class="btn btn-outline-primary active btn-sm">
                                    <input type="radio" name="options" id="option1" autocomplete="off" checked>
                                    By rating
                                </label>
                                <label id="latest_rated_button" data-order-type="latestrated" class="btn btn-outline-primary btn-sm">
                                    <input type="radio" name="options" id="option2" autocomplete="off">
                                    Latest rated
                                </label>
                                <label id="latest_added_button" data-order-type="latestadded" class="btn btn-outline-primary btn-sm">
                                    <input type="radio" name="options" id="option3" autocomplete="off">
                                    Latest added
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-2 d-none d-md-block">
                        <div class="text-right">
                            <button type="button" class="btn btn-link" data-toggle="modal" data-target="#myModal2" /><img src="~/images/Icon/Menu.svg">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @*table*@
        <div class="container">
            <div class="row table-head">
                <div class="col-md-7 col">Fact</div>
                <div class="col-md-1 col-sm-1 d-none d-md-block text-right"></div>
                <div class="col-2 d-none d-md-block">Proof</div>
                <div class="col-md-2 col text-right">Rating</div>
            </div>
            <div id="content_container">
                @foreach (var msg in Model)
                {
                    <div class="row table-post">
                        <div class="col-md-7 col-8 order-md-1 order-1">
                            @msg.FactTitle @*Ruis autem vel eum iure reprehenderit qui in ea voluptate velit esse quam.*@
                            <br />
                            @{
                                if ((msg.FactHashTags != null) && (msg.FactHashTags.Length > 0))
                                {
                                    var arr = msg.FactHashTags.Split("#");

                                    if (arr.Length > 0)
                                    {
                                        foreach (var has_tag in arr)
                                        {
                                            if (has_tag.Length > 0)
                                            {
                                                <a href="#" class="badge badge-primary">#@has_tag</a>
                                            }

                                        }
                                    }
                                }
                            }
                            @*
                                <a href="#" class="badge badge-primary">#primary</a>
                                <a href="#" class="badge badge-primary">#primary</a>
                            *@
                        </div>
                        <div class="col-md-1 col-6 order-md-2 order-4 post-time text-right">
                            @((msg.FactCreateDate?.Date.Day < 10) ?
                            $"0{msg.FactCreateDate?.Date.Day.ToString()}" :
                            msg.FactCreateDate?.Date.Day.ToString())-@((msg.FactCreateDate?.Date.Month < 10) ?
$"0{msg.FactCreateDate?.Date.Month.ToString()}" :
msg.FactCreateDate?.Date.Month.ToString())
                            @*05-04*@
