                                    </div>
                                </div>

                                <div class="col-lg-8 col-md-12 col order-lg-2 order-md-1 order-1 text-right">
                                    <div class="@((msg.FactRating > 0) ? " post_rating golden " : " post_rating banned")">
                                        @(
                                            (msg.FactRating > 0) ?
                                            $"+{msg.FactRating.ToString()}" :
                                            msg.FactRating.ToString()
                                        )
                                        @*+239 122*@
                                        <div class="golden-dot"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
