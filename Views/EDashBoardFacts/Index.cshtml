@model IEnumerable<FactotumModels.EDashBoardFact>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FactTitle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FactLink)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FactCreateDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FactRating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FactHashTags)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FactLastRateDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FactTitle)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FactLink)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FactCreateDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FactRating)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FactHashTags)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FactLastRateDate)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.FactId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.FactId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.FactId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
